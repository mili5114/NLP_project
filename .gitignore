# Allow small, explicitly reviewed smoke evidence and DEV directory placeholders.
!/runs/smoke/
!/runs/smoke/*.out
!/runs/dev_baselines/
!/runs/dev_baselines/.gitkeep

# Large artifacts: keep only the archive index and placeholder
artifacts/**
!artifacts/README.md
!artifacts/.gitkeep

# Generated results: retain the explicitly marked synthetic demonstration
results/*
!results/synthetic/
!results/synthetic/**

# OS and editors
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

